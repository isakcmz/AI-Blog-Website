
@{
    ViewData["Title"] = "CreateArticleTitleWithOpenAI";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


﻿<main class="page-content">
    <!--breadcrumb-->
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3">Yapay Zeka Destekli Makale Asistanı</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">AI Makale Başlık Oluşturucu</li>
                </ol>
            </nav>
        </div>
    </div>
    <!--end breadcrumb-->

    <div class="card">
        <div class="card-body">

            <form method="post">
                <input type="text"
                       name="topic"
                       class="form-control mb-2"
                       placeholder="Örn: Yapay zekanın yazılım sektörüne etkisi" />

                <button class="btn btn-success">Başlık Oluştur</button>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3">@ViewBag.Error</div>
            }

            @if (ViewBag.Article != null)
            {
                <hr />
                <h4>Oluşturulan Makale</h4>
                <div class="card p-3">
                    @Html.Raw(ViewBag.Article.Replace("\n", "<br/>"))
                </div>
            }
        </div>
    </div>

</main>

