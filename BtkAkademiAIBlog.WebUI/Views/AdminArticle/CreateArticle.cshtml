@model CreateArticleDto

@{
    ViewData["Title"] = "CreateArticle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}



<main class="page-content">
    <!--breadcrumb-->
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3">Makaleler</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Yeni Makale Ekleme</li>
                </ol>
            </nav>
        </div>
    </div>
    <!--end breadcrumb-->

    <div class="card">
        <div class="card-body">

            <form method="post">
                <label> Makale Başlığı</label>
                <input type="text" asp-for="Title" class="form-control" />
                <br />
                <label>Kapak Resmi (Thumbnail URL) </label>
                <input type="text" asp-for="CoverImageUrl" class="form-control" />
                <br />
                <label> Makale Detayı Ana Resim URL</label>
                <input type="text" asp-for="MainImageUrl" class="form-control" />
                <br />
                <label> Kategori</label>
                <input type="text" asp-for="Title" class="form-control" />
                <br />
                <label> Öne Çıkan(Feature) Slider Görsel URL</label>
                <input type="text" asp-for="FeatureSliderImageUrl" class="form-control" />
                <br />
                <label> Öne Çıkan(Feature) Görsel URL</label>
                <input type="text" asp-for="FeatureImageUrl" class="form-control" />
                <br />
                <label> Yazar Bilgisi</label>
                <input type="text" asp-for="Title" class="form-control" />
                <br />
                <label> Makale İçeriği</label>
                <textarea class="form-control" asp-for="Content"></textarea>
                <br />
                <button class="btn btn-primary">Makaleyi Oluştur</button>
            </form>
        </div>
    </div>

</main>

