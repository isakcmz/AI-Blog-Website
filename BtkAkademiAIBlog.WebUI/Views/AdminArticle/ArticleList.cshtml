@model List<ResultArticleDto>

@{
    ViewData["Title"] = "ArticleList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<main class="page-content">
    <!--breadcrumb-->
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3">Makaleler & Bloglar</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Makale Listesi</li>
                </ol>
            </nav>
        </div>
    </div>
    <!--end breadcrumb-->

    <div class="card">
        <div class="card-body">
            <div class="table-responsive mt-3">
                <table class="table align-middle">
                    <thead class="table-secondary">
                        <tr>
                            <th>#</th>
                            <th>Başlık</th>
                            <th>Tarih</th>
                            <th>Kategori Adı</th>
                            <th>Yazar</th>
                            <th>Sil</th>
                            <th>Güncelle</th>
                            <th>Sitede Gör</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ArticleId</td>
                                <td>@item.Title</td>
                                <td>@item.CreatedDate.ToString("dd-MMM-yyyy")</td>
                                <td>@item.CategoryName</td>
                                <td>@item.Name @item.Surname</td>
                                <td><a href="/AdminArticle/DelteArticle/@item.ArticleId" class="btn btn-danger">Sil</a></td>
                                <td><a href="/AdminArticle/UpdateArticle/@item.ArticleId" class="btn btn-success">Güncelle</a></td>
                                <td><a href="/Article/ArticleDetail/@item.ArticleId" class="btn btn-warning">Sitede Gör</a></td>
                            </tr>
                        }

                    </tbody>
                </table>
                <a href="/AdminArticle/CreateArticle/" class="btn btn-info"> Yeni Makale Girişi </a>
            </div>
        </div>
    </div>

</main>


