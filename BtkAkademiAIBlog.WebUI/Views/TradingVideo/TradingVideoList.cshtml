@model List<ResultTradingVideoDto>

@{
    ViewData["Title"] = "TradingVideoList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}



<main class="page-content">
    <!--breadcrumb-->
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3">Videolu Makaleler</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Video İçerikleri Listesi</li>
                </ol>
            </nav>
        </div>
    </div>
    <!--end breadcrumb-->

    <div class="card">
        <div class="card-body">
            <div class="table-responsive mt-3">
                <table class="table align-middle">
                    <thead class="table-secondary">
                        <tr>
                            <th>#</th>
                            <th>Başlık</th>
                            <th>Oluşturma Tarihi</th>
                            <th>Sil</th>
                            <th>Güncelle</th>
                            <th>Youtube'da Gör</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.TradingVideoId</td>
                                <td>@item.Title</td>
                                <td>@item.CreatedDate.ToString("dd-MMM-yyyy")</td>
                                <td><a href="/TradingVideo/DeleteTradingVideo/@item.TradingVideoId" class="btn btn-danger"> Sil </a></td>
                                <td><a href="/TradingVideo/UpdateTradingVideo/@item.TradingVideoId" class="btn btn-success"> Güncelle </a></td>
                                <td><a href="/TradingVideo/YoutubeTradingVideo/@item.TradingVideoId" class="btn btn-warning"> Youtube'da Gör </a></td>
                            </tr>
                        }

                    </tbody>
                </table>
                <a href="/TradingVideo/CreateTradingVideo/" class="btn btn-info"> Yeni Video Ekle </a>
            </div>
        </div>
    </div>

</main>

