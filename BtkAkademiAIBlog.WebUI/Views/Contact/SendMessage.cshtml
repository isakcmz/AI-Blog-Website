@model CreateMessageDto

@{
    ViewData["Title"] = "SendMessage";
    Layout = "~/Views/UILayout/Index.cshtml";
}



<div class="back-wrapper">
    <!--================= Back Breadcrumbs Section Start Here =================-->
    <div class="back-breadcrumbs">
        <div class="breadcrumbs-wrap">
            <div class="breadcrumbs-inner">
                <div class="container">
                    <div class="breadcrumbs-text">
                        <h1 class="breadcrumbs-title">Bizimle İletişime Geçin</h1>
                        <div class="back-nav">
                            <ul>
                                <li><a href="/Default/Index/">Ana Sayfa</a></li>
                                <li>İletişim</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--================= Back Breadcrumbs Section End Here =================-->

    <div id="back-contact" class="back-contact-page pt-70 pb-70">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <!--================= Form Section Start Here =================-->
                    <div class="back-blog-form">
                        <div class="back-title">
                            <h2>Bize Yazın</h2>
                        </div>
                        <div class="row">
                            <div class="col-lg-3 back-address pt-12">
                                <strong>Call Us</strong><br>
                                <a href="tel:@ViewBag.PhoneNumber1"> @ViewBag.PhoneNumber1 </a><br>
                                <a href="tel:@ViewBag.PhoneNumber2"> @ViewBag.PhoneNumber2</a><br>

                                <strong class="pt-30">Email Adreslerimiz</strong><br>
                                <a href="mailto:@ViewBag.Email1">@ViewBag.Email1</a>
                                <a href="mailto:@ViewBag.Email2">@ViewBag.Email2</a>

                                <br/>

                                <strong class="pt-30">Ofisimiz</strong><br>
                                <p>@ViewBag.Address</p>

                                <strong class="pt-30">Sosyal Medya</strong><br>
                                <ul class="social-link">
                                    <li><a href="#"><i class="fa-brands fa-facebook-f"></i></a></li>
                                    <li><a href="#"><i class="fa-brands fa-twitter"></i></a></li>
                                    <li><a href="#"><i class="fa-brands fa-instagram"></i></a></li>
                                    <li><a href="#"><i class="fa-brands fa-linkedin-in"></i></a></li>
                                </ul>
                            </div>
                            <div class="col-lg-9">
                                <div id="blog-form" class="blog-form">
                                    <div id="form-messages"></div>
                                    <form id="contact-form" method="post">
                                        <div class="row">
                                            <div class="col-lg-6">
                                                <div class="back-input">
                                                    <input id="name" type="text" asp-for="Name" placeholder="Adınız">
                                                </div>
                                            </div>

                                            <div class="col-lg-6 pdl-5">
                                                <div class="back-input">
                                                    <input id="name" type="text" asp-for="Surname" placeholder="Soyadınız">
                                                </div>
                                            </div>

                                            <div class="col-lg-6">
                                                <div class="back-input">
                                                    <input id="email" type="email" asp-for="Email" placeholder="Email Adresiniz">
                                                </div>
                                            </div>

                                            <div class="col-lg-6 pdl-5">
                                                <div class="back-input">
                                                    <input id="subject" type="text" asp-for="Subject" placeholder="Mesaj Konusu">
                                                </div>
                                            </div>

                                            <div class="col-lg-12">
                                                <div class="back-textarea">
                                                    <textarea id="message" asp-for="MessageDetail" placeholder="Mesajınız..."></textarea>
                                                </div>
                                            </div>

                                            <div class="col-lg-12">
                                                <button type="submit" class="back-btn">Mesajı Gönder</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--================= Form Section End Here =================-->
                </div>
            </div>
        </div>
    </div>

    <!--=================  Map Section Start Here =================-->
    <div class="back-contacts">
        <div class="back-image-maping">
            <iframe src="@ViewBag.MapLocation" width="100%" height="500" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
    </div>
    <!--================= Map Section End Here =================-->
</div>

