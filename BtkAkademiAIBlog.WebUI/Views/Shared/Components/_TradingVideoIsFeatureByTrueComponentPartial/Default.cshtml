

<div class="col-lg-8">
    <ul>
        <li>
            <div class="image-area">
                <a href="#"><img src="@ViewBag.FeatueImageUrl" alt="image"></a>
                <a href="@ViewBag.EmbedVideoUrl" class="popup-videos back-video"><i class="fa-solid fa-play"></i></a>
                <div class="back-btm-content">
                    <h3><a href="#">@ViewBag.Title</a></h3>
                    <ul>
                        <li class="back-author"><span><img src="@ViewBag.UserImageUrl" alt="image"></span><a href="#">@ViewBag.UserNameSurname</a></li>
                        <li class="back-date"><span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-clock"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></span>@ViewBag.CreatedDate.ToString("dd-MMM-yyyy")</li>
                    </ul>
                </div>
            </div>
        </li>
    </ul>
</div>