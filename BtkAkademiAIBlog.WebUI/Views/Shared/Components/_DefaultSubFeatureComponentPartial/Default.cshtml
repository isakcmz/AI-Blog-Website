@model List<ResultArticlesSubFeatureStatusByTrueDto>


<div class="col-lg-8">
    <div class="back-title">
        <h2>Öne Çıkan Güncel İçerikler</h2>
    </div>

    <ul class="back-hero-bottom back-hero-bottom2">
        
        @foreach(var item in Model)
        {
            <li>
                <div class="image-areas">
                    <a href="#"><img src="@item.SubFeatureImageUrl" alt="image"></a>
                </div>
                <div class="back-btm-content">
                    <a href="#" class="back-cate back-tra">@item.CategoryName</a>
                    <h3><a href="#">@item.Title</a></h3>
                    <p>@item.Content.Substring(0,70)...</p>
                    <ul class="back-meta">
                        <li class="back-author"><span><img src="/template/assets/images/author/1.jpg" alt="image"></span>Yazar: <a href="#">@item.Name @item.Surname</a></li>
                        <li class="back-date"><span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-clock"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></span>@item.CreatedDate.ToString("dd-MMM-yyyy")</li>
                    </ul>
                </div>
            </li>
        }
        

    </ul>
    <div class="text-center pt-73">
        <a href="/Article/ArticleList/" class="back-btn">Tüm Yazıları Görün</a>
    </div>
</div>