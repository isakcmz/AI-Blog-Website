@model List<ResultLast4ArticleWithCategoryDto>

<div class="back-title back-small-title pt-30">
    <h2>Son Yazılar</h2>
</div>
<ul class="back-hero-bottom">
    
    @foreach(var item in Model)
    {
        <li>
            <div class="image-areas">
                <a href="/Article/ArticleDetail/@item.ArticleId"><img src="@item.Image300x300Url" alt="image"></a>
            </div>
            <div class="back-btm-content">
                <a href="#" class="back-cates">@item.CategoryName</a>
                <h3><a href="/Article/ArticleDetail/@item.ArticleId">@item.Title</a></h3>
                <ul>
                    <li class="back-date"><a href="/Author/AuthorDetail/@item.AuthorId">@item.AuthorName</a></li>
                </ul>
            </div>
        </li>
    }

</ul>

<div class="back-add pt-15"> <img src="/template/assets/images/whats/add.jpg" alt="add-image"> </div>