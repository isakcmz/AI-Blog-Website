<div class="single-nav">

    @if (ViewBag.previousPost != null)
    {
        <div class="back-prev">
            <a href="/Article/ArticleDetail/@ViewBag.previousPost.ArticleId">
                <i class="fa-solid fa-arrow-right"></i>
                Önceki Yazı
                <em>@ViewBag.previousPost.Title</em>
            </a>
        </div>
    }

    @if (ViewBag.nextPost != null)
    {
        <div class="back-next">
            <a href="/Article/ArticleDetail/@ViewBag.nextPost.ArticleId">
                Sonraki Yazı
                <i class="fa-solid fa-arrow-right"></i>
                <em>@ViewBag.nextPost.Title</em>
            </a>
        </div>
    }

</div>