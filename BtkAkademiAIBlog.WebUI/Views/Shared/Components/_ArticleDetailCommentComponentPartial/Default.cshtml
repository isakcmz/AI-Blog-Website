@model List<ResultCommentWithUserDto>


<div class="author-comment">
    <div class="back-title back-small-title">
        <h2>@Model.Count Yorum</h2>
    </div>
    <ul>
        @foreach(var item in Model)
        {
            <li>
                <div class="row">
                    <div class="col-lg-1">
                        <div class="image-comments"><img src="@item.UserImageUrl" alt=""> </div>
                    </div>
                    <div class="col-lg-11">
                        <div class="dsc-comments">
                            <h6>@item.Name @item.Surname</h6>
                            <span class="reply"> <span class="date">@item.CommentDate.ToString("HH:mm dd-MMM-yyyy")</span></span>
                            <p> @item.CommentDetail </p>
                        </div>
                    </div>
                </div>
            </li>
        }
        
    </ul>
</div>
