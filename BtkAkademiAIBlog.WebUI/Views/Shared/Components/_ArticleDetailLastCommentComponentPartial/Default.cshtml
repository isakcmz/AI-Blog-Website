@model List<GetLast3CommentWithUserDto>


<div class="back-title back-small-title pt-50">
    <h2>Son Yorumlaar</h2>
</div>
<div class="widget back-recent-comments">
    <ul class="recent-comments">

        @foreach(var item in Model)
        {
            <li>
                <span class="post-images"><img src="@item.UserImageUrl" style="height:80px ; width:100px;" alt="post"></span>
                <div class="titles">
                    <h4>@item.Name @item.Surname</h4>
                    <span>@item.CommentDate.ToString("dd-MMM-yyyy HH:mm")</span>
                    <a href="/Article/ArticleDetail/@item.ArticleId"><p>@item.CommentDetail</p></a>
                </div>
            </li>
        }
        

    </ul>
</div>
