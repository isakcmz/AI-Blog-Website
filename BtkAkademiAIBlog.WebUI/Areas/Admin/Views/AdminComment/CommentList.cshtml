@model List<ResultCommentDto>

@{
    ViewData["Title"] = "CommentList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}


<main class="page-content">
    <!--breadcrumb-->
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3">Yorumlar</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item">
                        <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Yorum Listesi</li>
                </ol>
            </nav>
        </div>
    </div>
    <!--end breadcrumb-->

    <div class="card">
        <div class="card-body">
            <div class="table-responsive mt-3">
                <table class="table align-middle">
                    <thead class="table-secondary">
                        <tr>
                            <th>#</th>
                            <th>Makale</th>
                            <th>Kullancı</th>
                            <th>Yorum</th>
                            <th>Tarih</th>
                            <th>Onaylandı Mı?</th>
                            <th>Durumu</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model)
                        {
                            count++;

                            <tr>
                                <td>@count</td>
                                <td>@item.Title</td>
                                <td>@item.Name @item.Surname</td>
                                <td>@item.CommentDetail</td>
                                <td>@item.CommentDate.ToString("dd-MMM-yyyy")</td>
                                <td>@item.IsConfirm</td>
                                <td>@item.CommentStatus</td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>

</main>

